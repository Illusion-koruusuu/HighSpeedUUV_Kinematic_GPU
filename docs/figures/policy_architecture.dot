digraph PolicyArchitecture {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.30",
    nodesep="0.55",
    ranksep="0.62",
    fontname="Noto Sans CJK SC"
  ];
  node [
    shape=box,
    style="rounded,filled",
    width=3.8,
    height=1.0,
    fontname="Noto Sans CJK SC",
    fontsize=18,
    margin="0.17,0.13",
    color="#CBD5E1",
    penwidth=1.3
  ];
  edge [
    color="#475569",
    arrowsize=0.82,
    penwidth=1.7
  ];

  observations [
    label="观测输入\n声呐历史 3 × 6 × 12 × 48\n状态标量 target(4) + path(5) + motion(7)",
    width=7.6,
    fillcolor="#EFF6FF",
    color="#93C5FD"
  ];
  sonar_encoder [
    label="声呐编码器\n共享 CNN：32 → 64 → 64\nLSTM hidden = 128",
    fillcolor="#E0E7FF",
    color="#818CF8"
  ];
  state_encoder [
    label="状态编码器\n16 → 128 → 128\n两层 MLP",
    fillcolor="#DCFCE7",
    color="#4ADE80"
  ];
  fusion [
    label="特征融合\n声呐 128 维 + 状态 128 维 → 256 维",
    width=7.6,
    fillcolor="#F8FAFC",
    color="#94A3B8"
  ];
  actor [
    label="BC Actor\n基础动作均值\nPPO 阶段冻结",
    fillcolor="#FFF7ED",
    color="#FDBA74"
  ];
  critic [
    label="Critic\n状态价值 V(s)\nPPO 阶段训练",
    fillcolor="#F5F3FF",
    color="#C4B5FD"
  ];
  residual [
    label="残差动作头\n零初始化\n缩放 0.15",
    fillcolor="#FEF2F2",
    color="#FCA5A5"
  ];
  warmup [
    label="Critic warmup\n前 10k 步只训练 Critic\n之后开放残差更新",
    shape=note,
    fillcolor="#FAF5FF",
    color="#D8B4FE"
  ];
  action [
    label="最终动作\n[speed, yaw_rate, pitch_rate]",
    width=5.0,
    fillcolor="#FFFBEB",
    color="#FCD34D"
  ];

  observations -> sonar_encoder;
  observations -> state_encoder;
  sonar_encoder -> fusion;
  state_encoder -> fusion;
  {
    rank=same;
    actor;
    critic;
  }
  fusion -> actor;
  fusion -> critic;
  {
    rank=same;
    residual;
    warmup;
  }
  actor -> residual -> action;
  warmup -> critic [style=dashed];
  warmup -> residual [style=dashed];
}
