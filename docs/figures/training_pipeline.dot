digraph TrainingPipeline {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.30",
    nodesep="0.55",
    ranksep="0.65",
    fontname="Noto Sans CJK SC"
  ];
  node [
    shape=box,
    style="rounded,filled",
    width=4.2,
    height=1.25,
    fontname="Noto Sans CJK SC",
    fontsize=18,
    margin="0.18,0.14",
    color="#CBD5E1",
    penwidth=1.4
  ];
  edge [
    fontname="Noto Sans CJK SC",
    fontsize=14,
    color="#475569",
    arrowsize=0.85,
    penwidth=1.8
  ];

  scene [
    label="1  场景与仿真\n300–450 个全空间障碍；4–22 m\n动态障碍 1–10 kn；GPU 声呐\n速度、加速度、转弯和俯仰约束",
    fillcolor="#FFF7ED",
    color="#FDBA74"
  ];
  teacher_bc [
    label="2  教师与模仿学习\n动态 Dijkstra + 比例/阻尼闭环控制\nBC 学习成功轨迹\nDAgger 用教师纠正学生访问状态",
    fillcolor="#ECFDF5",
    color="#86EFAC"
  ];
  ppo [
    label="3  LSTM + 残差 PPO\n3 帧声呐历史提取动态信息\n冻结 BC 主策略，只学习小幅修正\n先训练 Critic，再开放残差动作",
    fillcolor="#FEF2F2",
    color="#FCA5A5"
  ];
  eval [
    label="4  评估与可视化\n成功率、碰撞、越界、超时\n速度跟踪、净距和控制约束\n轨迹诊断图、实时播放和 HoloOcean 回放",
    fillcolor="#EFF6FF",
    color="#93C5FD"
  ];

  {
    rank=same;
    scene -> teacher_bc;
  }
  {
    rank=same;
    ppo;
    eval;
  }
  teacher_bc -> ppo;
  ppo -> eval;
  ppo -> scene [
    style=dashed,
    label="在线交互",
    constraint=false
  ];
}
